<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sarah_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sarah settings"
            android:textColor="@color/sarah_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Build 2.1-device-voice-setup"
            android:textColor="@color/sarah_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Conversation AI: OpenAI, selected by the app team. Premium online voice: Sarah Morgan on ElevenLabs when the team includes her connection. People installing Sarah are not asked for provider keys or model names."
            android:textColor="@color/sarah_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Connection behavior"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/webSearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Allow current public and connected research for events, maps, routes, schedules, weather, attractions, hotels, and travel information" />

        <CheckBox
            android:id="@+id/autoResearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Automatically refresh destination and event knowledge when internet is available" />

        <CheckBox
            android:id="@+id/mediaPreviewCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Show an inline public photo preview and Map, Photos, Videos, Route, and Official Source tools for relevant places and events" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Without the team OpenAI connection, Sarah still uses public-source tools for recognized and unfamiliar events, maps, public media, routes, and selected factual questions. Without ElevenLabs or internet, she automatically speaks with Android's local voice."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="People using the same phone"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use the person icon to switch saved profiles. A new person may say “My name is …” and Sarah creates a separate profile, asks their age, applies age-appropriate suggestions, and asks once whether they are joining the active trip."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Travel and event monitoring"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/dealAlertsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Schedule background event, air, rail, bus, transit, driving, ferry, hotel, and deal checks when team services are available" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current prices, schedules, room inventory, delays, and automatic notifications require lawful team-owned sources. The person using Sarah does not enter those service credentials here."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sarah's voice"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/voiceModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The selected Sarah Morgan ElevenLabs voice uses Eleven Multilingual v2 with the voice-design settings used for the approved samples. If the service is missing, slow, out of credits, or offline, Sarah continues with Android speech instead of becoming silent."
            android:textSize="13sp" />

        <Button
            android:id="@+id/voiceProvisioningButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Activate Sarah Morgan voice on this phone"
            android:textAllCaps="false" />

        <CheckBox
            android:id="@+id/autoSpeakCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Read Sarah's replies aloud" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android fallback voice speed" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="45" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Memory"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/learnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Let Sarah learn approved interests, preferences, past trips, routes, worries, event trips, loyalty context, and requested watches for the correct active profile" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Hackathon prototype: public releases should keep shared OpenAI, ElevenLabs, hotel, travel-commerce, and voice-agent credentials on protected authenticated backends rather than inside an APK. This private phone-activation path stores only public-key ciphertext in GitHub and keeps the decryption key in Android Keystore."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
