<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sarah_warm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sarah settings"
            android:textColor="@color/sarah_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Build 1.6-profiles-events"
            android:textColor="@color/sarah_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Conversation AI: OpenAI, selected by the app team. People who install Sarah are not asked for an API key or model name. If the team changes providers, it edits SarahModelConfig.java and ConnectedModelGateway.java, then builds a new APK."
            android:textColor="@color/sarah_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Connection behavior"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/webSearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Allow current public and connected research for events, maps, routes, schedules, weather, attractions, and travel information" />

        <CheckBox
            android:id="@+id/autoResearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Automatically refresh destination and event knowledge when internet is available" />

        <CheckBox
            android:id="@+id/mediaPreviewCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Show an inline public photo preview and Map, Photos, Videos, Route, and Official Source buttons for relevant places and events" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Online without the team OpenAI connection, Sarah still uses public-source tools for known events, best-effort discovery of unfamiliar events, maps, public photos, videos, routes, and selected factual questions. Public lookup is useful but is not a replacement for a full language model."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="People using the same phone"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use the person icon beside the question-mark button to switch saved profiles. A new person may say “My name is …” and Sarah will create a separate profile, ask their age, apply age-appropriate suggestions, ask memory permission for an adult, and ask once whether they are joining the current planned trip. Child preference memory stays off unless a responsible adult later enables it."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Travel and event monitoring"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/dealAlertsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Schedule background event, air, rail, bus, transit, driving, ferry, and deal checks when the team services are available" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current schedules, delays, prices, and automatic notifications require team-owned source services. The user does not enter those service credentials here."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Sarah's voice"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/voiceModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/autoSpeakCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Read Sarah's replies aloud" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice speed" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="45" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Memory"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/learnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Let Sarah learn approved interests, travel preferences, past trips, routes, worries, wish-list places, event trips, and requested watches for the correct active profile" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Hackathon prototype: a public release should keep shared provider credentials on a protected authenticated backend, not inside an APK. See README.md for the exact source files used to change OpenAI, the model ID, or the backend."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
