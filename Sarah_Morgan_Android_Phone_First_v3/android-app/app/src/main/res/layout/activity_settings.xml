<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sarah_warm"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/buildVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sarah settings"
            android:textColor="@color/sarah_navy"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sarah Travel OS 2.5"
            android:textColor="@color/sarah_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buildDetailsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Build details"
            android:textColor="@color/sarah_text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Sarah uses her connected mind when it is available and continues with saved knowledge and on-device tools when it is not. Her natural online voice falls back automatically to the phone’s offline voice. No technical setup is required here."
            android:textColor="@color/sarah_text"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Online and offline mind"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/webSearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Allow current public and connected research for events, maps, routes, schedules, weather, attractions, hotels, and travel information" />

        <CheckBox
            android:id="@+id/autoResearchCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Automatically refresh destination and event knowledge when internet is available" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Location"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/nearbyDiscoveryCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="With my permission, let Sarah use my saved home/current area for nearby source-backed events and places that match my interests" />

        <EditText
            android:id="@+id/nearbyAreaInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Approved approximate area, such as Newark, NJ"
            android:inputType="textCapWords" />

        <Button
            android:id="@+id/useCurrentLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use my current location"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/currentLocationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location permission has not been used. Sarah stores only a profile-scoped city/area, not raw coordinates."
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/mediaPreviewCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Show an inline public photo preview and Map, Photos, Videos, Route, and Official Source tools for relevant places and events" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="If the connected mind is unavailable, Sarah can still use saved knowledge, on-device tools, maps, public media, and supported public-source lookups. Without internet, she automatically uses the phone’s local voice."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Offline flight companion"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Breathing, conversation, noticing games and trivia remain available without signal."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Profile"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use the person icon to switch separate profiles. Unknown age remains family-safe."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Email and bookings"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Not connected · share a booking link, message, image or PDF through Connections."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Travel and event monitoring"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/dealAlertsCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="Automatic travel monitoring · setup required" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current prices, schedules, room inventory, delays, and automatic notifications require a verified live connection. Sarah labels when that connection is unavailable instead of inventing a result."
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Sarah's voice"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/voiceModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/voiceRouteStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Voice route status"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/autoSpeakCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Read Sarah's replies aloud" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Android fallback voice speed" />

        <SeekBar
            android:id="@+id/speedSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="45" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Devices and synchronization"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/autoDeviceSyncCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="After Sarah replies, quietly synchronize with every explicitly paired desktop or laptop that is available on this trusted Wi-Fi network" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/mode_status_background"
            android:padding="12dp"
            android:text="Memory and privacy"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/learnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Let Sarah learn approved interests, preferences, past trips, routes, worries, event trips, loyalty context, and requested watches for the correct active profile" />

        <Button
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Sarah labels whether each reply was connected, on-device, or a fallback. Current prices, events, schedules, and availability require a verified source for that turn."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
