<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/futuristic_header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="7dp"
        android:paddingRight="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SARAH MORGAN"
            android:textColor="#F2FCFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:background="@drawable/mode_status_background"
            android:clickable="true"
            android:contentDescription="Conversation, voice, and connection status. Tap for connection choices."
            android:ellipsize="end"
            android:focusable="true"
            android:maxLines="2"
            android:paddingLeft="9dp"
            android:paddingTop="5dp"
            android:paddingRight="9dp"
            android:paddingBottom="5dp"
            android:text="Sarah is ready"
            android:textColor="#F2FCFF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="#EAFBFF" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/sarahPresenceHost"
        android:layout_width="match_parent"
        android:layout_height="218dp"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="10dp"
        android:background="@drawable/futuristic_media_panel"
        android:contentDescription="Sarah's live animated presence">

        <com.kiraworld.sarahtravel.SarahPortraitView
            android:id="@+id/sarahPortraitView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Approved portrait of Sarah with lightweight live motion" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left|bottom"
            android:layout_margin="10dp"
            android:background="@drawable/mode_status_background"
            android:paddingLeft="9dp"
            android:paddingTop="4dp"
            android:paddingRight="9dp"
            android:paddingBottom="4dp"
            android:text="Sarah is here"
            android:textColor="#F2FCFF"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|top"
            android:gravity="right"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/presencePowerButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/icon_button"
                android:contentDescription="Turn portrait motion power saving on or off"
                android:padding="9dp"
                android:src="@drawable/ic_presence_power"
                android:tint="@color/sarah_navy" />

            <TextView
                android:id="@+id/presenceModeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/mode_status_background"
                android:paddingLeft="7dp"
                android:paddingTop="2dp"
                android:paddingRight="7dp"
                android:paddingBottom="2dp"
                android:text="Motion on"
                android:textColor="#F2FCFF"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="6dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp">

        <Button
            android:id="@+id/voiceCallButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginRight="4dp"
            android:layout_weight="1"
            android:background="@drawable/send_button"
            android:contentDescription="Talk with Sarah by voice"
            android:text="Talk with Sarah"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.kiraworld.sarahtravel.TravelHubButton
            android:id="@+id/travelHubButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="4dp"
            android:layout_weight="1"
            android:contentDescription="Open Sarah's Travel Workbench"
            android:textSize="14sp" />
    </LinearLayout>

    <com.kiraworld.sarahtravel.ExploreButton
        android:id="@+id/exploreButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/futuristic_media_panel"
        android:contentDescription="Source-bound destination photo preview with maps, more public photos, videos, routes, and current sources"
        android:minHeight="52dp"
        android:text="Maps, photos, video and routes"
        android:textAllCaps="false"
        android:textColor="#F4FDFF"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tripContextToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:contentDescription="Show optional travel and calm tools"
        android:focusable="true"
        android:paddingLeft="16dp"
        android:paddingTop="5dp"
        android:paddingRight="16dp"
        android:paddingBottom="5dp"
        android:text="More tools"
        android:textColor="@color/sarah_navy"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/tripContextPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/calmButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Calm, grounding, and trivia"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_help"
                android:tint="@color/sarah_navy" />

            <com.kiraworld.sarahtravel.FlightCalmButton
                android:id="@+id/flightCalmButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <com.kiraworld.sarahtravel.ProfileButton
                android:id="@+id/profileButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Switch the person talking with Sarah"
                android:padding="9dp"
                android:tint="@color/sarah_navy" />

            <ImageButton
                android:id="@+id/notebookButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Travel notebook"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/sarah_navy" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.kiraworld.sarahtravel.ProactiveDiscoveryButton
                android:id="@+id/proactiveDiscoveryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.kiraworld.sarahtravel.TrustedSyncButton
                android:id="@+id/trustedSyncButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="10dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/composer_background"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/photoButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Choose a travel photo"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/sarah_navy" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Talk with Sarah"
            android:padding="10dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/sarah_navy" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            android:background="@drawable/input_field"
            android:gravity="center_vertical|start"
            android:hint="Message Sarah"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingLeft="13dp"
            android:paddingTop="9dp"
            android:paddingRight="13dp"
            android:paddingBottom="9dp"
            android:textColor="@color/sarah_text"
            android:textColorHint="#746F68"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/send_button"
            android:contentDescription="Send message"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
