<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sarah_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="18dp"
        android:paddingTop="14dp"
        android:paddingRight="8dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sarah Morgan"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/mode_status_background"
                android:clickable="true"
                android:contentDescription="Conversation and public lookup status. Tap to change connection settings."
                android:focusable="true"
                android:paddingLeft="10dp"
                android:paddingTop="5dp"
                android:paddingRight="10dp"
                android:paddingBottom="5dp"
                android:text="Local mode • tap to switch"
                android:textColor="#F2F7FA"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/calmButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Calm and trivia mode"
            android:src="@android:drawable/ic_menu_help"
            android:tint="@color/white" />

        <com.kiraworld.sarahtravel.ProfileButton
            android:id="@+id/profileButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch the person talking with Sarah"
            android:padding="8dp"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/notebookButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Travel notebook"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="@color/white" />

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@android:drawable/ic_menu_preferences"
            android:tint="@color/white" />
    </LinearLayout>

    <com.kiraworld.sarahtravel.ExploreButton
        android:id="@+id/exploreButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="2dp"
        android:minHeight="76dp"
        android:contentDescription="Explore maps, public photos, videos, routes, and current travel sources"
        android:text="Explore maps • photos • videos • routes"
        android:textAllCaps="false"
        android:textColor="@color/sarah_navy"
        android:textSize="14sp" />

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/composerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/composer_background"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/photoButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Choose trip photo"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/sarah_navy" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Push to talk"
            android:padding="11dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/sarah_navy" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            android:background="@drawable/input_field"
            android:gravity="center_vertical|start"
            android:hint="Type a message to Sarah"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="50dp"
            android:paddingLeft="13dp"
            android:paddingTop="10dp"
            android:paddingRight="13dp"
            android:paddingBottom="10dp"
            android:textColor="@color/sarah_text"
            android:textColorHint="#746F68"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/send_button"
            android:contentDescription="Send"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
