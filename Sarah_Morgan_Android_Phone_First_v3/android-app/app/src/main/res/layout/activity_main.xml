<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/futuristic_header_background"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="Sarah logo"
                android:padding="2dp"
                android:src="@drawable/ic_sarah_orbit" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="@drawable/mode_status_background"
                android:clickable="true"
                android:contentDescription="Conversation, voice, and connection status. Tap to change connection settings."
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="2"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:text="Local mind ready"
                android:textColor="#F2FCFF"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Settings"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:tint="#EAFBFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tripContextToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Show calm, profile, and notebook shortcuts"
            android:focusable="true"
            android:paddingLeft="14dp"
            android:paddingTop="6dp"
            android:paddingRight="14dp"
            android:paddingBottom="6dp"
            android:text="Trip context and calm tools ▾"
            android:textColor="#EAFBFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/tripContextPanel"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/calmButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Calm, grounding, and trivia"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_help"
                android:tint="#EAFBFF" />

            <com.kiraworld.sarahtravel.FlightCalmButton
                android:id="@+id/flightCalmButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <com.kiraworld.sarahtravel.ProfileButton
                android:id="@+id/profileButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Switch the person talking with Sarah"
                android:padding="9dp"
                android:tint="#EAFBFF" />

            <ImageButton
                android:id="@+id/notebookButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Travel notebook"
                android:padding="9dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#EAFBFF" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingTop="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/composerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/composer_background"
        android:gravity="center_vertical"
        android:minHeight="68dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/photoButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Choose trip photo"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_camera"
            android:tint="@color/sarah_navy" />

        <ImageButton
            android:id="@+id/micButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="5dp"
            android:background="@drawable/icon_button"
            android:contentDescription="Push to talk"
            android:padding="11dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:tint="@color/sarah_navy" />

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp"
            android:layout_weight="1"
            android:background="@drawable/input_field"
            android:gravity="center_vertical|start"
            android:hint="Talk with Sarah"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="50dp"
            android:paddingLeft="13dp"
            android:paddingTop="10dp"
            android:paddingRight="13dp"
            android:paddingBottom="10dp"
            android:textColor="@color/sarah_text"
            android:textColorHint="#746F68"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/sendButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/send_button"
            android:contentDescription="Send"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F8FA"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/chatNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Chat"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/tripNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Trip"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/discoverNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Discover"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/connectionsNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:text="Connections"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
