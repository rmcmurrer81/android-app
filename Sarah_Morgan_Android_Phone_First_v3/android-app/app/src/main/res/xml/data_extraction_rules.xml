<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="secure_preferences.xml" />
        <exclude domain="sharedpref" path="sarah_profile_vault.xml" />
        <exclude domain="sharedpref" path="sarah_voice_receipts.xml" />
        <exclude domain="sharedpref" path="sarah_approximate_locations.xml" />
        <exclude domain="database" path="sarah.db" />
        <exclude domain="database" path="sarah_event_trips.db" />
        <exclude domain="file" path="booking_imports/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_preferences.xml" />
        <exclude domain="sharedpref" path="sarah_profile_vault.xml" />
        <exclude domain="sharedpref" path="sarah_voice_receipts.xml" />
        <exclude domain="sharedpref" path="sarah_approximate_locations.xml" />
        <exclude domain="database" path="sarah.db" />
        <exclude domain="database" path="sarah_event_trips.db" />
        <exclude domain="file" path="booking_imports/" />
    </device-transfer>
</data-extraction-rules>
