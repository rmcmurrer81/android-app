{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sarah.example/device-auth-error-matrix-v1.json",
  "title": "Sarah durable device-auth public error matrix v1",
  "description": "Canonical public code-to-HTTP-status bindings. This contract is not deployment evidence.",
  "version": "sarah-full-device-auth-errors-v1",
  "errors": {
    "authorization_pending": { "status": 202, "class": "enrollment" },
    "invalid_json": { "status": 400, "class": "request" },
    "request_read_failed": { "status": 400, "class": "request" },
    "invalid_base64url": { "status": 400, "class": "request" },
    "invalid_base64url_length": { "status": 400, "class": "request" },
    "noncanonical_base64url": { "status": 400, "class": "request" },
    "invalid_public_key": { "status": 400, "class": "request" },
    "invalid_public_key_fields": { "status": 400, "class": "request" },
    "invalid_public_key_curve": { "status": 400, "class": "request" },
    "platform_invalid": { "status": 400, "class": "request" },
    "purpose_invalid": { "status": 400, "class": "request" },
    "key_version_invalid": { "status": 400, "class": "request" },
    "rotation_id_invalid": { "status": 400, "class": "request" },
    "user_code_invalid": { "status": 400, "class": "request" },
    "invalid_rotation": { "status": 401, "class": "proof" },
    "invalid_token": { "status": 401, "class": "proof" },
    "unauthorized": { "status": 401, "class": "proof" },
    "owner_access_invalid": { "status": 401, "class": "proof" },
    "invalid_enrollment": { "status": 401, "class": "proof" },
    "invalid_enrollment_proof": { "status": 401, "class": "proof" },
    "unknown_device": { "status": 401, "class": "proof" },
    "invalid_device_proof": { "status": 401, "class": "proof" },
    "owner_access_denied": { "status": 403, "class": "authorization" },
    "owner_origin_rejected": { "status": 403, "class": "authorization" },
    "csrf_rejected": { "status": 403, "class": "authorization" },
    "enrollment_denied": { "status": 403, "class": "authorization" },
    "device_revoked": { "status": 403, "class": "authorization" },
    "device_lease_expired": { "status": 403, "class": "authorization" },
    "stale_key_version": { "status": 403, "class": "authorization" },
    "stale_auth_epoch": { "status": 403, "class": "authorization" },
    "stale_device_state": { "status": 403, "class": "authorization" },
    "scope_denied": { "status": 403, "class": "authorization" },
    "not_found": { "status": 404, "class": "routing" },
    "enrollment_not_found": { "status": 404, "class": "routing" },
    "device_not_found": { "status": 404, "class": "routing" },
    "method_not_allowed": { "status": 405, "class": "routing" },
    "enrollment_already_consumed": { "status": 409, "class": "state" },
    "challenge_already_consumed": { "status": 409, "class": "state" },
    "enrollment_state_invalid": { "status": 409, "class": "state" },
    "enrollment_state_conflict": { "status": 409, "class": "state" },
    "enrollment_not_expired": { "status": 409, "class": "state" },
    "device_state_changed": { "status": 409, "class": "state" },
    "device_already_revoked": { "status": 409, "class": "state" },
    "stale_rotation": { "status": 409, "class": "state" },
    "enrollment_expired": { "status": 410, "class": "expiry" },
    "challenge_expired": { "status": 410, "class": "expiry" },
    "wrong_api_origin": { "status": 421, "class": "routing" },
    "rate_limited": { "status": 429, "class": "throttle" },
    "request_too_large": { "status": 413, "class": "request" },
    "internal_error": { "status": 500, "class": "server" },
    "audit_metadata_too_large": { "status": 500, "class": "server" },
    "model_upstream_failed": { "status": 502, "class": "upstream" },
    "search_upstream_failed": { "status": 502, "class": "upstream" },
    "voice_upstream_failed": { "status": 502, "class": "upstream" },
    "auth_store_unavailable": { "status": 503, "class": "configuration" },
    "auth_store_corrupt": { "status": 503, "class": "configuration" },
    "auth_signing_unavailable": { "status": 503, "class": "configuration" },
    "auth_hashing_unavailable": { "status": 503, "class": "configuration" },
    "owner_access_unavailable": { "status": 503, "class": "configuration" },
    "owner_portal_not_configured": { "status": 503, "class": "configuration" },
    "api_origin_not_configured": { "status": 503, "class": "configuration" },
    "rate_limiter_unavailable": { "status": 503, "class": "configuration" },
    "runtime_not_configured": { "status": 503, "class": "configuration" },
    "model_unavailable": { "status": 503, "class": "configuration" },
    "search_unavailable": { "status": 503, "class": "configuration" },
    "voice_unavailable": { "status": 503, "class": "configuration" }
  },
  "dynamic_validation": {
    "pattern": "^[a-z0-9_]+_(required|invalid)$",
    "status": 400
  }
}
